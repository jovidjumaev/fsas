# Production Environment Variables
# Copy this to your production environment (Railway, Vercel, etc.)

# Backend API URL - Replace with your actual backend domain
NEXT_PUBLIC_API_URL=https://your-backend-domain.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenAI Configuration (Backend only)
OPENAI_API_KEY=your-openai-api-key
OPENAI_RATE_LIMIT_PER_HOUR=50
OPENAI_RATE_LIMIT_PER_DAY=1000

# Example for Railway:
# NEXT_PUBLIC_API_URL=https://fsas-backend-production.up.railway.app

# Example for Vercel:
# NEXT_PUBLIC_API_URL=https://fsas-backend.vercel.app

# Example for Heroku:
# NEXT_PUBLIC_API_URL=https://fsas-backend.herokuapp.com
